<Window x:Class="Parot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Parot.Controls"
        mc:Ignorable="d"
        Title="Parot"
        Icon="Assets/AppIcon.ico"
        Width="320" Height="370"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.ContextMenu>
        <ContextMenu x:Name="PetContextMenu" FontSize="12">
            <MenuItem x:Name="MenuMoodDisplay" Header="🎭 Mood: 🌟 Cheerful" Click="MenuMood_Click"/>
            <MenuItem x:Name="MenuPomodoro" Header="🍅 Start Pomodoro Focus (25m)" Click="MenuPomodoro_Click"/>
            <MenuItem x:Name="MenuAskParot" Header="✨ Ask Parot (AI Chat)" Click="MenuAskParot_Click"/>
            <MenuItem x:Name="MenuDailyReport" Header="📊 Daily Wellness Report" Click="MenuDailyReport_Click"/>
            <Separator/>
            <!-- Interactive Mini-Games & Toys -->
            <MenuItem x:Name="MenuMiniGames" Header="🎯 Mini-Games &amp; Toys">
                <MenuItem x:Name="MenuLaserPointer" Header="🔴 Laser Pointer Toy" Click="MenuLaserPointer_Click"/>
                <MenuItem x:Name="MenuDesktopMirror" Header="🪞 Desktop Mirror Trick" Click="MenuDesktopMirror_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuThrowChili" Header="🌶️ Throw Chili Treat" Click="MenuThrowChili_Click"/>
                <MenuItem x:Name="MenuThrowPeanut" Header="🥜 Throw Peanut Treat" Click="MenuThrowPeanut_Click"/>
                <MenuItem x:Name="MenuThrowSeed" Header="🌻 Throw Sunflower Seeds" Click="MenuThrowSeed_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuPerchCursor" Header="🎯 Perch on Mouse Cursor" Click="MenuPerchCursor_Click"/>
                <MenuItem x:Name="MenuBallPush" Header="⚽ Bouncy Ball Push Game" Click="MenuBallPush_Click"/>
                <MenuItem x:Name="MenuPlayTag" Header="🎮 Play Tag with Cursor" Click="MenuPlayTag_Click"/>
            </MenuItem>
            <!-- Avian Behaviors Submenu -->
            <MenuItem x:Name="MenuAvianBehaviors" Header="🕊️ Avian Behaviors">
                <MenuItem x:Name="MenuWalkTitlebar" Header="🚶 Walk on Titlebar" Click="MenuWalkTitlebar_Click"/>
                <MenuItem x:Name="MenuFlapPerch" Header="🪶 Flap Wings on Perch" Click="MenuFlapPerch_Click"/>
                <MenuItem x:Name="MenuCuriousLook" Header="👀 Curious Look Around" Click="MenuCuriousLook_Click"/>
                <MenuItem x:Name="MenuPreen" Header="✨ Preen Feathers" Click="MenuPreen_Click"/>
                <MenuItem x:Name="MenuStretch" Header="🧘 Wing &amp; Leg Stretch" Click="MenuStretch_Click"/>
                <MenuItem x:Name="MenuFluff" Header="💨 Fluff &amp; Shake Feathers" Click="MenuFluff_Click"/>
                <MenuItem x:Name="MenuYawn" Header="🥱 Lazy Yawn" Click="MenuYawn_Click"/>
                <MenuItem x:Name="MenuDizzy" Header="😵💫 Make Dizzy Trick" Click="MenuDizzy_Click"/>
            </MenuItem>
            <!-- Bird Species -->
            <MenuItem x:Name="MenuBirdSpecies" Header="🎨 Bird Species">
                <MenuItem x:Name="MenuSkinScarletMacaw" Header="🔴 Scarlet Macaw" Click="MenuSkinScarletMacaw_Click"/>
                <MenuItem x:Name="MenuSkinGreenParakeet" Header="🟢 Green Parakeet" Click="MenuSkinGreenParakeet_Click"/>
                <MenuItem x:Name="MenuSkinBlueMacaw" Header="🔵 Blue &amp; Gold Macaw" Click="MenuSkinBlueMacaw_Click"/>
                <MenuItem x:Name="MenuSkinCockatiel" Header="🟡 Cockatiel" Click="MenuSkinCockatiel_Click"/>
                <MenuItem x:Name="MenuSkinCockatoo" Header="⚪ White Cockatoo" Click="MenuSkinCockatoo_Click"/>
            </MenuItem>
            <!-- Accessories Submenu -->
            <MenuItem x:Name="MenuAccessories" Header="👓 Costumes &amp; Accessories">
                <MenuItem x:Name="MenuAccessorySunglasses" Header="🕶️ Cool Sunglasses" Click="MenuAccessorySunglasses_Click"/>
                <MenuItem x:Name="MenuAccessoryGlasses" Header="👓 Reading Glasses" Click="MenuAccessoryGlasses_Click"/>
                <MenuItem x:Name="MenuAccessoryScarf" Header="🧣 Winter Scarf" Click="MenuAccessoryScarf_Click"/>
                <MenuItem x:Name="MenuAccessoryTopHat" Header="🎩 Elegant Top Hat" Click="MenuAccessoryTopHat_Click"/>
                <MenuItem x:Name="MenuAccessoryPartyHat" Header="🥳 Party Cone Hat" Click="MenuAccessoryPartyHat_Click"/>
                <MenuItem x:Name="MenuAccessoryUmbrella" Header="☂️ Tiny Umbrella" Click="MenuAccessoryUmbrella_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuAccessoryNone" Header="🚫 Remove All Accessories" Click="MenuAccessoryNone_Click"/>
            </MenuItem>
            <!-- Voice & Audio -->
            <MenuItem x:Name="MenuVoiceAudio" Header="🎙️ Voice &amp; Audio">
                <MenuItem x:Name="MenuSoundToggle" Header="🔊 Sound: ON" Click="MenuSoundToggle_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuVoiceMimic" Header="🎙️ Record &amp; Echo Voice" Click="MenuVoiceMimic_Click"/>
                <MenuItem x:Name="MenuVoiceCommands" Header="🗣️ Voice Commands: Active" Click="MenuVoiceCommands_Click"/>
                <MenuItem x:Name="MenuSquawk" Header="💬 Squawk Loudly!" Click="MenuSquawk_Click"/>
            </MenuItem>
            <!-- Hunger & Feeding -->
            <MenuItem x:Name="MenuHungerFeeding" Header="🍽️ Hunger &amp; Feeding">
                <MenuItem x:Name="MenuHungerDisplay" Header="❤️ Fullness: 85%" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="MenuHuntPrey" Header="🐞 Hunt Ladybug" Click="MenuHuntPrey_Click"/>
                <MenuItem x:Name="MenuHuntGrasshopper" Header="🦗 Hunt Grasshopper" Click="MenuHuntGrasshopper_Click"/>
                <MenuItem x:Name="MenuFeedChili" Header="🌶️ Feed Spicy Chili" Click="MenuFeedChili_Click"/>
                <MenuItem x:Name="MenuFeedSeeds" Header="🌻 Feed Sunflower Seeds" Click="MenuFeedSeeds_Click"/>
            </MenuItem>
            <!-- Weather & Companion -->
            <MenuItem x:Name="MenuWeather" Header="🌦️ Check Live Weather" Click="MenuWeather_Click"/>
            <MenuItem x:Name="MenuCompanionBird" Header="🦜🦜 Toggle Bird Buddy" Click="MenuCompanion_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuSoundQuickToggle" Header="🔊 Sound: ON (Toggle Mute)" Click="MenuSoundToggle_Click"/>
            <MenuItem x:Name="MenuFlyAround" Header="🚀 Take Flight" Click="MenuFlyAround_Click"/>
            <MenuItem x:Name="MenuFollowCursor" Header="🎯 Follow Cursor" Click="MenuFollowCursor_Click"/>
            <MenuItem x:Name="MenuPerchMode" Header="🪟 Perch on Active Window" Click="MenuPerchMode_Click"/>
            <MenuItem x:Name="MenuBirdcage" Header="🏰 Put in Birdcage" Click="MenuBirdcage_Click"/>
            <MenuItem x:Name="MenuSleepWake" Header="💤 Go to Sleep" Click="MenuSleepWake_Click"/>
            <MenuItem x:Name="MenuEyeBreak" Header="👁️ Rest Eyes Now (20-20-20)" Click="MenuEyeBreak_Click"/>
            <MenuItem x:Name="MenuHydrate" Header="💧 Drink Water Reminder" Click="MenuHydrate_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuAutoStartup" Header="🚀 Start with Windows" Click="MenuAutoStartup_Click" IsCheckable="True"/>
            <MenuItem x:Name="MenuLanguage" Header="🌐 Language">
                <MenuItem x:Name="MenuLangEnglish" Header="🇬🇧 English" Click="MenuLangEnglish_Click" IsCheckable="True"/>
                <MenuItem x:Name="MenuLangBengali" Header="🇧🇩 বাংলা (Bengali)" Click="MenuLangBengali_Click" IsCheckable="True"/>
                <MenuItem x:Name="MenuLangHindi" Header="🇮🇳 हिन्दी (Hindi)" Click="MenuLangHindi_Click" IsCheckable="True"/>
                <MenuItem x:Name="MenuLangSpanish" Header="🇪🇸 Español (Spanish)" Click="MenuLangSpanish_Click" IsCheckable="True"/>
                <MenuItem x:Name="MenuLangBilingual" Header="🌐 বাংলা + English (Bilingual)" Click="MenuLangBilingual_Click" IsCheckable="True"/>
            </MenuItem>
            <MenuItem x:Name="MenuGhostMode" Header="👻 Ghost Mode (Click-Through)" Click="MenuGhostMode_Click"/>
            <MenuItem x:Name="MenuSettings" Header="⚙️ Settings..." Click="MenuSettings_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuExit" Header="❌ Exit Parot" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="MainCanvas" ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Floating Speech / Reminder Bubble -->
        <controls:SpeechBubbleControl x:Name="SpeechBubble"
                                      Grid.Row="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Top"
                                      Margin="0,0,0,0"/>


        <!-- Animated Parot Pet Character -->
        <controls:ParotPetControl x:Name="Pet"
                                  Grid.Row="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Cursor="Hand"
                                  MouseDown="Pet_MouseDown"
                                  MouseLeftButtonDown="Pet_MouseLeftButtonDown"
                                  MouseLeftButtonUp="Pet_MouseLeftButtonUp"
                                  MouseRightButtonUp="Pet_MouseRightButtonUp"
                                  MouseMove="Pet_MouseMove"/>
    </Grid>
</Window>
