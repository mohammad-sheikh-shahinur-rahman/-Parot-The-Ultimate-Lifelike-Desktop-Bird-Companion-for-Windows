<Window x:Class="Parot.Views.DesktopMirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Mirror"
        Width="180" Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown">
    <Grid>
        <!-- Vintage Golden Mirror Frame -->
        <Border Margin="12,12,12,32" CornerRadius="80,80,18,18" BorderThickness="6" BorderBrush="#F59E0B">
            <Border.Background>
                <!-- Mirror Glass Tint with glossy reflection -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#CCEDF7FA" Offset="0.0"/>
                    <GradientStop Color="#99CDE5EC" Offset="0.4"/>
                    <GradientStop Color="#BBDBEAFE" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#B45309" BlurRadius="12" ShadowDepth="4" Opacity="0.6"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Reflection Light Streak -->
                <Polygon Points="0,0 80,0 0,160" Fill="#40FFFFFF"/>

                <!-- Mirrored Avatar Representation -->
                <Viewbox Margin="10,20,10,10" VerticalAlignment="Bottom">
                    <Grid x:Name="MirrorAvatarContainer">
                        <Grid.RenderTransform>
                            <!-- Horizontally flipped to create authentic mirror reflection -->
                            <ScaleTransform ScaleX="-1" CenterX="60"/>
                        </Grid.RenderTransform>
                        <Image x:Name="MirrorAvatarImage" Width="120" Height="110" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Viewbox>

                <!-- Sparkle Emoji -->
                <TextBlock Text="✨" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"/>
            </Grid>
        </Border>

        <!-- Golden Mirror Base Stand -->
        <Rectangle Width="70" Height="10" Fill="#D97706" RadiusX="4" RadiusY="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26">
            <Rectangle.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.35"/>
            </Rectangle.Effect>
        </Rectangle>
        <!-- Golden Stand Stem -->
        <Rectangle Width="10" Height="16" Fill="#B45309" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34"/>

        <!-- Close Button (Top right) -->
        <Button Content="✕" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,4,4,0" Background="#EF4444" Foreground="White" FontWeight="Bold" FontSize="10"
                BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
    </Grid>
</Window>
