<Window x:Class="Parot.Views.LaserPointerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laser Pointer"
        Width="70" Height="70"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False">
    <Grid>
        <!-- Radiant Laser Glow -->
        <Ellipse Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#90FF0033" Offset="0.0"/>
                    <GradientStop Color="#40FF0000" Offset="0.45"/>
                    <GradientStop Color="#00FF0000" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Intense Core Beam -->
        <Ellipse Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#FF0033" Offset="0.8"/>
                    <GradientStop Color="#CC0000" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF0000" BlurRadius="12" ShadowDepth="0" Opacity="0.95"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Catch Sparkles (when bird reaches the dot) -->
        <TextBlock x:Name="CatchSparkle" Text="💥" FontSize="26"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0"/>
    </Grid>
</Window>
