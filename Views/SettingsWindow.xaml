<Window x:Class="Parot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Parot - Settings &amp; Customization"
        Height="680" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Vrinda, Nirmala UI">
    
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.04" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#DCFCE7" CornerRadius="12" Width="44" Height="44" Margin="0,0,12,0">
                <TextBlock Text="🦜" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Parot Settings &amp; Studio" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="ডেস্কটপ বাডি, স্কিন, ড্যান্স ও ফোকাস কন্ট্রোল" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Grid>

        <!-- Scrollable Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <!-- 1. Bird Skins & Accessories Card (Feature 5) -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🎨 পাখির প্রজাতি ও পোশাক (Skins &amp; Accessories)" FontWeight="Bold" FontSize="13" Foreground="#059669" Margin="0,0,0,10"/>

                        <!-- Skin Selection -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="পাখির প্রজাতি (Bird Species):" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbSkin" Width="190" FontSize="12">
                                <ComboBoxItem Content="🔴 স্কারলেট ম্যাকাও (Scarlet Macaw)" IsSelected="True"/>
                                <ComboBoxItem Content="🟢 সবুজ দেশি টিয়া (Parakeet)"/>
                                <ComboBoxItem Content="🟡 হলুদ ককাটেল (Cockatiel)"/>
                                <ComboBoxItem Content="🔵 নীল-হলুদ ম্যাকাও (Macaw)"/>
                            </ComboBox>
                        </Grid>

                        <!-- Accessories Selection -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="সাজসজ্জা / পোশাক (Accessories):" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbAccessory" Width="170" FontSize="12">
                                <ComboBoxItem Content="কোনোটি নয় (None)"/>
                                <ComboBoxItem Content="👓 পড়ার চশমা (Glasses)"/>
                                <ComboBoxItem Content="🕶️ সানগ্লাস (Sunglasses)"/>
                                <ComboBoxItem Content="🧣 শীতের মাফলার (Scarf)"/>
                                <ComboBoxItem Content="🎩 টপ হ্যাট (Top Hat)"/>
                                <ComboBoxItem Content="🥳 উৎসবের টুপি (Party Hat)"/>
                                <ComboBoxItem Content="☂️ ছাতা (Umbrella)"/>
                            </ComboBox>
                        </Grid>

                        <!-- Perch Mode Selection (Feature 4) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="বসার স্থান (Perch Position):" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbPerchMode" Width="170" FontSize="12">
                                <ComboBoxItem Content="🖥️ ডেস্কটপ ও টাস্কবার"/>
                                <ComboBoxItem Content="🪟 সক্রিয় উইন্ডোর ওপর (Active Window)"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Pomodoro & Music Dance Card (Features 1 & 2) -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="⏱️ পোমোডোরো ও মিউজিক ড্যান্স (Focus &amp; Dance)" FontWeight="Bold" FontSize="13" Foreground="#059669" Margin="0,0,0,10"/>

                        <!-- Pomodoro Focus Interval -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="পোমোডোরো ফোকাস পর্ব:" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbPomodoroFocus" Width="120" FontSize="12">
                                <ComboBoxItem Content="২০ মিনিট"/>
                                <ComboBoxItem Content="২৫ মিনিট" IsSelected="True"/>
                                <ComboBoxItem Content="৩০ মিনিট"/>
                                <ComboBoxItem Content="৪৫ মিনিট"/>
                                <ComboBoxItem Content="৫০ মিনিট"/>
                            </ComboBox>
                        </Grid>

                        <!-- Pomodoro Break Interval -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="পোমোডোরো বিরতি পর্ব:" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbPomodoroBreak" Width="120" FontSize="12">
                                <ComboBoxItem Content="৩ মিনিট"/>
                                <ComboBoxItem Content="৫ মিনিট" IsSelected="True"/>
                                <ComboBoxItem Content="১০ মিনিট"/>
                            </ComboBox>
                        </Grid>

                        <!-- Dance to Music Toggle -->
                        <CheckBox x:Name="ChkDanceToMusic" Content="🎶 গান বাজলে তালে তালে নাচবে (Beat-Sync Headbanging)" IsChecked="True" FontSize="12" Margin="0,0,0,6"/>
                        <!-- Night Mode Toggle -->
                        <CheckBox x:Name="ChkNightModeAuto" Content="🌙 রাত ১০টার পর ঘুমানোর ক্যাপ পরবে (Night Mode Auto)" IsChecked="True" FontSize="12" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- 3. AI Assistant & Gemini (Feature 3) -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🤖 এআই ও ভয়েস (Gemini AI &amp; Voice Mimic)" FontWeight="Bold" FontSize="13" Foreground="#059669" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkVoiceMimic" Content="টিয়া পাখির কণ্ঠে কথা বলা সক্রিয় রাখুন (Voice Mimic)" IsChecked="True" FontSize="12" Margin="0,0,0,8"/>

                        <TextBlock Text="Google Gemini API Key (ঐচ্ছিক — অনলাইন এআই চ্যাটের জন্য):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtGeminiKey" FontSize="11" Padding="6,4" Margin="0,0,0,4">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- 4. Companion Size & Behavior Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🦜 পাখির আকার ও আচরণ (Pet Behavior)" FontWeight="Bold" FontSize="13" Foreground="#059669" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Companion Size (আকার):" FontSize="12" Foreground="#334155"/>
                            <TextBlock Grid.Column="1" x:Name="TxtScaleVal" Text="100%" FontWeight="SemiBold" FontSize="12" Foreground="#059669"/>
                        </Grid>
                        <Slider x:Name="SliderScale" Minimum="0.7" Maximum="1.6" Value="1.0" SmallChange="0.1" LargeChange="0.2"
                                TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="SliderScale_ValueChanged" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkAlwaysOnTop" Content="সব উইন্ডোর উপরে থাকবে (Always on Top)" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>
                        <CheckBox x:Name="ChkAllowWalking" Content="ডেস্কটপে মাঝে মাঝে হাঁটাহাঁটি করবে (Allow Roaming)" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>
                        <CheckBox x:Name="ChkGhostMode" Content="ক্লিক-থ্রু মোড / Ghost Mode" IsChecked="False" Margin="0,0,0,8" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- 5. Sound & Reminders Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🔊 সাউন্ড ও হেলথ রিমাইন্ডার (Audio &amp; Wellness)" FontWeight="Bold" FontSize="13" Foreground="#059669" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkSoundEnabled" Content="পাখির ডাক ও সাউন্ড চালু রাখুন" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>
                        <CheckBox x:Name="ChkScreenBreak" Content="২০-২০-২০ চোখের বিশ্রাম রিমাইন্ডার" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>
                        <CheckBox x:Name="ChkHydration" Content="পানি পানের রিমাইন্ডার" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Content="📊 View Daily Report" Style="{StaticResource SecondaryButton}" Click="BtnDailyReport_Click" Margin="0,0,6,0"/>
                            <Button Content="🔊 Test Chirp" Style="{StaticResource SecondaryButton}" Click="BtnTestSound_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="🌶️ Feed Treat" Style="{StaticResource SecondaryButton}" Click="BtnFeedTreat_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="বাতিল (Cancel)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Content="সংরক্ষণ করুন (Save)" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
