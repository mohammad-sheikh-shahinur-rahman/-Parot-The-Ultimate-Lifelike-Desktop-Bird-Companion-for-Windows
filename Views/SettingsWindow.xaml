<Window x:Class="Parot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Parot - Settings &amp; Customization"
        Icon="../Assets/AppIcon.ico"
        Height="680" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Vrinda, Nirmala UI">
    
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.04" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="10" Width="44" Height="44" Margin="0,0,12,0" ClipToBounds="True">
                <Image Source="../Assets/WindowsAssets/Square150x150Logo.scale-200.png" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Parot Settings &amp; Studio" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock x:Name="TxtSettingsSubtitle" Text="Desktop companion, skins, dance &amp; wellness controls" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Grid>

        <!-- Scrollable Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <!-- 1. Bird Skins & Accessories Card (Feature 5) -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock x:Name="TxtCard1Title" Text="🎨 Bird Species &amp; Costumes" FontWeight="Bold" FontSize="13" Foreground="#059669" Margin="0,0,0,10"/>

                        <!-- Skin Selection -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtLabelSkin" Text="Bird Species:" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbSkin" Width="190" FontSize="12">
                                <ComboBoxItem Content="🔴 Scarlet Macaw" IsSelected="True"/>
                                <ComboBoxItem Content="🟢 Green Parakeet"/>
                                <ComboBoxItem Content="🟡 Cockatiel"/>
                                <ComboBoxItem Content="🔵 Blue &amp; Gold Macaw"/>
                            </ComboBox>
                        </Grid>

                        <!-- Accessories Selection -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtLabelAccessory" Text="Costumes / Accessories:" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbAccessory" Width="170" FontSize="12">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="👓 Reading Glasses"/>
                                <ComboBoxItem Content="🕶️ Cool Sunglasses"/>
                                <ComboBoxItem Content="🧣 Winter Scarf"/>
                                <ComboBoxItem Content="🎩 Top Hat"/>
                                <ComboBoxItem Content="🥳 Party Hat"/>
                                <ComboBoxItem Content="☂️ Umbrella"/>
                            </ComboBox>
                        </Grid>

                        <!-- Perch Mode Selection (Feature 4) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtLabelPerchMode" Text="Perch Position:" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbPerchMode" Width="170" FontSize="12">
                                <ComboBoxItem Content="🖥️ Desktop &amp; Taskbar"/>
                                <ComboBoxItem Content="🪟 Active Window Titlebar"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Pomodoro & Music Dance Card (Features 1 & 2) -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock x:Name="TxtCard2Title" Text="⏱️ Focus &amp; Dance (Pomodoro)" FontWeight="Bold" FontSize="13" Foreground="#059669" Margin="0,0,0,10"/>

                        <!-- Pomodoro Focus Interval -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtLabelPomodoroFocus" Text="Pomodoro Focus Duration:" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbPomodoroFocus" Width="120" FontSize="12">
                                <ComboBoxItem Content="20 min"/>
                                <ComboBoxItem Content="25 min" IsSelected="True"/>
                                <ComboBoxItem Content="30 min"/>
                                <ComboBoxItem Content="45 min"/>
                                <ComboBoxItem Content="50 min"/>
                            </ComboBox>
                        </Grid>

                        <!-- Pomodoro Break Interval -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtLabelPomodoroBreak" Text="Pomodoro Break Duration:" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbPomodoroBreak" Width="120" FontSize="12">
                                <ComboBoxItem Content="3 min"/>
                                <ComboBoxItem Content="5 min" IsSelected="True"/>
                                <ComboBoxItem Content="10 min"/>
                            </ComboBox>
                        </Grid>

                        <!-- Dance to Music Toggle -->
                        <CheckBox x:Name="ChkDanceToMusic" Content="🎶 Dance to system music beats (Beat-Sync)" IsChecked="True" FontSize="12" Margin="0,0,0,6"/>
                        <!-- Night Mode Toggle -->
                        <CheckBox x:Name="ChkNightModeAuto" Content="🌙 Night mode auto-sleep cap after 10 PM" IsChecked="True" FontSize="12" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- 3. AI Assistant & Gemini (Feature 3) -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock x:Name="TxtCard3Title" Text="🤖 AI Assistant &amp; Voice Mimic" FontWeight="Bold" FontSize="13" Foreground="#059669" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkVoiceMimic" Content="Enable voice mimicry &amp; high-pitch parrot speech" IsChecked="True" FontSize="12" Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtLabelGeminiKey" Text="Google Gemini API Key (optional — for online AI chat):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtGeminiKey" FontSize="11" Padding="6,4" Margin="0,0,0,4">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- 4. Companion Size & Behavior Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock x:Name="TxtCard4Title" Text="🦜 Companion Size &amp; Behavior" FontWeight="Bold" FontSize="13" Foreground="#059669" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtLabelScale" Text="Companion Size:" FontSize="12" Foreground="#334155"/>
                            <TextBlock Grid.Column="1" x:Name="TxtScaleVal" Text="100%" FontWeight="SemiBold" FontSize="12" Foreground="#059669"/>
                        </Grid>
                        <Slider x:Name="SliderScale" Minimum="0.7" Maximum="1.6" Value="1.0" SmallChange="0.1" LargeChange="0.2"
                                TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="SliderScale_ValueChanged" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkAlwaysOnTop" Content="Always on Top of other windows" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>
                        <CheckBox x:Name="ChkAllowWalking" Content="Allow occasional desktop roaming &amp; walking" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>
                        <CheckBox x:Name="ChkAutonomousFlight" Content="🚀 Autonomous flight across screen" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>
                        <CheckBox x:Name="ChkBirdcageMode" Content="🏰 Birdcage Mode (Keep bird calm inside cage)" IsChecked="False" Margin="0,0,0,8" FontSize="12"/>
                        <CheckBox x:Name="ChkFollowCursor" Content="🎯 Follow mouse cursor" IsChecked="False" Margin="0,0,0,8" FontSize="12"/>
                        <CheckBox x:Name="ChkGhostMode" Content="Click-through Mode / Ghost Mode" IsChecked="False" Margin="0,0,0,8" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- 5. Sound & Reminders Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock x:Name="TxtCard5Title" Text="🔊 Audio &amp; Digital Wellness Reminders" FontWeight="Bold" FontSize="13" Foreground="#059669" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkSoundEnabled" Content="Enable bird chirps and audio effects" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>
                        <CheckBox x:Name="ChkScreenBreak" Content="20-20-20 Eye break reminder" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>
                        <CheckBox x:Name="ChkHydration" Content="Drink water hydration reminder" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button x:Name="BtnDailyReport" Content="📊 View Daily Report" Style="{StaticResource SecondaryButton}" Click="BtnDailyReport_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnTestSound" Content="🔊 Test Chirp" Style="{StaticResource SecondaryButton}" Click="BtnTestSound_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 6. System & Language Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock x:Name="TxtCard6Title" Text="🌐 System &amp; Language" FontWeight="Bold" FontSize="13" Foreground="#059669" Margin="0,0,0,10"/>

                        <!-- Language Selection -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtLabelLanguage" Text="Application Language:" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbLanguage" Width="180" FontSize="12" SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBoxItem Content="🇬🇧 English"/>
                                <ComboBoxItem Content="🇧🇩 বাংলা (Bengali)"/>
                                <ComboBoxItem Content="🇮🇳 हिन्दी (Hindi)"/>
                                <ComboBoxItem Content="🇪🇸 Español (Spanish)"/>
                                <ComboBoxItem Content="🌐 বাংলা + English (Bilingual)"/>
                            </ComboBox>
                        </Grid>

                        <!-- Auto-Startup Toggle -->
                        <CheckBox x:Name="ChkStartWithWindows" Content="🚀 Start automatically with Windows" IsChecked="False" Margin="0,2,0,2" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnFeedTreat" Content="🌶️ Feed Treat" Style="{StaticResource SecondaryButton}" Click="BtnFeedTreat_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave" Content="Save Settings" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
