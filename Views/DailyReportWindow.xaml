<Window x:Class="Parot.Views.DailyReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Parot - Daily Wellness &amp; Focus Report"
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Vrinda, Nirmala UI">

    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" Color="#000000" Opacity="0.04" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#DCFCE7" CornerRadius="12" Width="44" Height="44" Margin="0,0,12,0">
                <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Daily Wellness &amp; Focus" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock x:Name="TxtDate" Text="Today's Report" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Grid>

        <!-- Content Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Friendship & Level Banner -->
                <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⭐" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtFriendshipLevel" Text="Friendship Level 2 (Best Buddy)" FontWeight="Bold" FontSize="14" Foreground="#065F46"/>
                            <TextBlock x:Name="TxtTotalXP" Text="Total XP: 185 XP" FontSize="11" Foreground="#047857" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#10B981" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="LOYAL 🦜" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 1. Screen Time -->
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⏱️" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Active Screen Time (সক্রিয় সময়)" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                            <TextBlock Text="আজকের কাজের সময়কাল" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="TxtActiveTime" Text="3h 45m" FontWeight="Bold" FontSize="14" Foreground="#0284C7" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 2. Eye Breaks -->
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="👁️" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Eye Breaks Taken (চোখের বিশ্রাম)" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                            <TextBlock Text="২০-২০-২০ নিয়মে চোখের যত্ন" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="TxtEyeBreaks" Text="8 বার" FontWeight="Bold" FontSize="14" Foreground="#059669" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 3. Hydration Glasses -->
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="💧" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Water Consumed (পানি পান)" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                            <TextBlock Text="পর্যাপ্ত পানি আপনাকে সতেজ রাখে" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="TxtWaterGlasses" Text="5 গ্লাস" FontWeight="Bold" FontSize="14" Foreground="#0284C7" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 4. Pomodoros -->
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🍅" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Pomodoros Finished (ফোকাস সেশন)" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                            <TextBlock Text="২৫ মিনিটের গভীর মনোযোগ পর্ব" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="TxtPomodoroCount" Text="4 সেশন" FontWeight="Bold" FontSize="14" Foreground="#E11D48" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Motivational Note -->
                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
                    <TextBlock x:Name="TxtEncouragement"
                               Text="🎉 চমৎকার পারফরম্যান্স! আপনি নিজের চোখের ও স্বাস্থ্যের দারুণ যত্ন নিচ্ছেন।"
                               FontSize="11" Foreground="#475569" TextWrapping="Wrap" LineHeight="16"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button Content="ঠিক আছে (Close)"
                    HorizontalAlignment="Right"
                    Background="#10B981" Foreground="#FFFFFF"
                    FontWeight="SemiBold" FontSize="12"
                    Padding="18,7" BorderThickness="0" Cursor="Hand"
                    Click="BtnClose_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
