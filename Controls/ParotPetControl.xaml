            <Rectangle Canvas.Left="20" Canvas.Top="216" Width="220" Height="7" Fill="#CA8A04" RadiusX="3" RadiusY="3"/>
            <Rectangle Canvas.Left="16" Canvas.Top="222" Width="228" Height="4" Fill="#A16207" RadiusX="2" RadiusY="2"/>
        </Canvas>

        <!-- Particles Layer -->
        <Canvas x:Name="ParticleCanvas" ClipToBounds="False">
            <!-- Heart Particle -->
            <TextBlock x:Name="HeartParticle"
                       Text="❤️" FontSize="22"
                       Canvas.Left="200" Canvas.Top="15"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="HeartTranslate" Y="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Music Note Particle -->
            <TextBlock x:Name="NoteParticle"
                       Text="🎵" FontSize="20"
                       Canvas.Left="205" Canvas.Top="20"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="NoteTranslate" Y="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Sleep Zzz Particles -->
            <StackPanel x:Name="SleepParticles"
                        Canvas.Left="205" Canvas.Top="10"
                        Opacity="0">
                <TextBlock Text="Z" FontSize="18" FontWeight="Bold" Foreground="#3B82F6"/>
                <TextBlock Text="z" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" Margin="6,-4,0,0"/>
                <TextBlock Text="z" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" Margin="12,-4,0,0"/>
            </StackPanel>

            <!-- Sleep Dream Bubble 💭 🌙 -->
