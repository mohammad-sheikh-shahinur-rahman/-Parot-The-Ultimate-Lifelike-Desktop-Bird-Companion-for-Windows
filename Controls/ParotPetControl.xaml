            <!-- Treat Food Item / Prey (Ladybug, Grasshopper, Seed, Chili) -->
            <TextBlock x:Name="TreatItem"
                       Text="🐞" FontSize="24"
                       Canvas.Left="215" Canvas.Top="175"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TreatTranslate" Y="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Canvas>
    </Grid>
</UserControl>
