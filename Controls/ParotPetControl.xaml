            <Path Data="M 60,204 Q 70,120 130,30" Stroke="#EAB308" StrokeThickness="1.8" Fill="Transparent"/>
            <Path Data="M 200,204 Q 190,120 130,30" Stroke="#EAB308" StrokeThickness="1.8" Fill="Transparent"/>
            <Rectangle Canvas.Left="55" Canvas.Top="204" Width="150" Height="6" Fill="#B45309" RadiusX="2" RadiusY="2"/>
