<UserControl x:Class="Parot.Controls.ParotPetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="260" Height="230">
    <UserControl.Resources>
        <!-- Breathing / Gentle Idling Animation -->
        <Storyboard x:Key="BreatheStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BirdScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.02" Duration="0:0:2.0">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Hop Storyboard -->
        <Storyboard x:Key="HopStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTranslateTransform"
                                           Storyboard.TargetProperty="Y">
                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="-26"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdScaleTransform"
                                           Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="0.94"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1.06"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="0.96"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Subtle Head Tilt Storyboard -->
        <Storyboard x:Key="HeadTiltStoryboard">
            <DoubleAnimation Storyboard.TargetName="BirdRotateTransform"
                             Storyboard.TargetProperty="Angle"
                             To="5" Duration="0:0:0.25" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Dance Storyboard -->
        <Storyboard x:Key="DanceStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BirdRotateTransform"
                             Storyboard.TargetProperty="Angle"
                             From="-6" To="6" Duration="0:0:0.2" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BirdTranslateTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-8" Duration="0:0:0.2" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <BounceEase Bounces="1" Bounciness="2" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Flap Storyboard (Rapid flutter pulse) -->
        <Storyboard x:Key="FlapStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BirdScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.96" To="1.04" Duration="0:0:0.14"/>
            <DoubleAnimation Storyboard.TargetName="BirdTranslateTransform"
                             Storyboard.TargetProperty="Y"
                             From="-4" To="4" Duration="0:0:0.14"/>
        </Storyboard>

        <!-- Chirp / Squawk Head Bob Storyboard -->
        <Storyboard x:Key="ChirpStoryboard">
            <DoubleAnimation Storyboard.TargetName="BirdScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.06" Duration="0:0:0.1" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="BirdRotateTransform"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="4" Duration="0:0:0.12" AutoReverse="True"/>
        </Storyboard>

        <!-- Realistic Peck / Eat Storyboard -->
        <Storyboard x:Key="PeckStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdRotateTransform"
                                           Storyboard.TargetProperty="Angle">
                <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="14"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.38" Value="16"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.50" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.64" Value="18"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.78" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdTranslateTransform"
                                           Storyboard.TargetProperty="Y">
                <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.38" Value="6"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.50" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.64" Value="7"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.78" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Preening Feathers Storyboard (Meticulous wing & breast feather grooming) -->
        <Storyboard x:Key="PreenStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdRotateTransform" Storyboard.TargetProperty="Angle">
                <!-- Nibble wing feathers -->
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="-18"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.40" Value="-10"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="-20"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-12"/>
                <!-- Preen breast feathers -->
                <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="14"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.20" Value="6"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.40" Value="16"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.70" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdTranslateTransform" Storyboard.TargetProperty="Y">
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="4"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="6"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.70" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdScaleTransform" Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="0.95"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="0.94"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.70" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Wing & Leg Stretch Storyboard (Bird Yoga) -->
        <Storyboard x:Key="StretchStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdRotateTransform" Storyboard.TargetProperty="Angle">
                <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="-14"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="-14"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.90" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdScaleTransform" Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="1.14"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="1.14"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.90" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdTranslateTransform" Storyboard.TargetProperty="Y">
                <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="-7"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="-7"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.90" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Feather Fluff & Shake Storyboard (Whole-body vibration ruffle) -->
        <Storyboard x:Key="FluffStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdScaleTransform" Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame KeyTime="0:0:0.10" Value="1.12"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0.95"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.26" Value="1.10"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.34" Value="0.96"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1.08"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdScaleTransform" Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0.10" Value="1.10"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0.96"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.26" Value="1.09"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.34" Value="0.97"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1.06"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Yawn Storyboard (Relaxed big beak opening) -->
        <Storyboard x:Key="YawnStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdRotateTransform" Storyboard.TargetProperty="Angle">
                <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="-6"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="-6"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdScaleTransform" Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="1.07"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1.07"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Dizzy Storyboard (Rapid head wobble) -->
        <Storyboard x:Key="DizzyStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdRotateTransform" Storyboard.TargetProperty="Angle">
                <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="-16"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="16"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="-14"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="14"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="-10"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="10"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Perch Wing Flap Storyboard (Vigorously flapping wings while gripping perch firmly) -->
        <Storyboard x:Key="PerchFlapStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdScaleTransform" Storyboard.TargetProperty="ScaleX" RepeatBehavior="6x">
                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="1.18"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.16" Value="0.94"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdScaleTransform" Storyboard.TargetProperty="ScaleY" RepeatBehavior="6x">
                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="0.92"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.16" Value="1.06"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdTranslateTransform" Storyboard.TargetProperty="Y" RepeatBehavior="6x">
                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="-8"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.16" Value="2"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Curious Head Rotation & Cock (মাথা ঘোরাবে ও কাত করবে) -->
        <Storyboard x:Key="CuriousLookStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdRotateTransform" Storyboard.TargetProperty="Angle">
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="-16"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-16"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="18"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="18"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.95" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdTranslateTransform" Storyboard.TargetProperty="X">
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="-4"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-4"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.95" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Waddling Walk Storyboard (Alternating footsteps weight shift, stepping bounce and head bob) -->
        <Storyboard x:Key="WaddleStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdRotateTransform" Storyboard.TargetProperty="Angle">
                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="-5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.26" Value="5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdTranslateTransform" Storyboard.TargetProperty="Y">
                <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="-5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.26" Value="-5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Beak Wipe Storyboard (Rubbing beak on perch to clean/hone after eating/preening) -->
        <Storyboard x:Key="BeakWipeStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdRotateTransform" Storyboard.TargetProperty="Angle">
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="-20"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="-8"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="-22"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="20"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="8"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.32" Value="22"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdTranslateTransform" Storyboard.TargetProperty="Y">
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="6"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.32" Value="6"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Head Scratch Storyboard (Scratching neck/head with foot) -->
        <Storyboard x:Key="HeadScratchStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdRotateTransform" Storyboard.TargetProperty="Angle">
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="-22"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.38" Value="-16"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.50" Value="-24"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.62" Value="-16"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-24"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.88" Value="-16"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.00" Value="-22"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdTranslateTransform" Storyboard.TargetProperty="Y">
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="4"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.50" Value="6"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="6"/>
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Tail Wag Storyboard (Happy content feather shuffle & tail wag) -->
        <Storyboard x:Key="TailWagStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdRotateTransform" Storyboard.TargetProperty="Angle">
                <SplineDoubleKeyFrame KeyTime="0:0:0.10" Value="-8"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.20" Value="8"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.30" Value="-8"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.40" Value="8"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.50" Value="-5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BirdScaleTransform" Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame KeyTime="0:0:0.20" Value="1.06"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.40" Value="0.96"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="1.04"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Width="260" Height="230" ClipToBounds="False">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScaleTransform" ScaleX="1" ScaleY="1" CenterX="130" CenterY="214"/>
                <TranslateTransform x:Name="RootTranslateTransform" X="0" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Natural Floor / Taskbar Contact Shadow (Realistic Ambient Occlusion) -->
        <Ellipse x:Name="GroundContactShadow"
                 Width="150" Height="14"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,1"
                 Opacity="0.40"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#55000000" Offset="0"/>
                    <GradientStop Color="#20000000" Offset="0.55"/>
                    <GradientStop Color="#00000000" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Real Photographic Scarlet Macaw Sprite Container -->
        <Grid x:Name="BirdContainer" Width="260" Height="230" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BirdScaleTransform" ScaleX="1" ScaleY="1" CenterX="130" CenterY="214"/>
                    <TranslateTransform x:Name="BirdTranslateTransform" X="0" Y="0"/>
                    <RotateTransform x:Name="BirdRotateTransform" Angle="0" CenterX="130" CenterY="214"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Photorealistic High-Definition Bird Image (Feet firmly grounded at bottom) -->
            <Image x:Name="BirdSpriteImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom">
                <Image.Effect>
                    <DropShadowEffect x:Name="BirdSpriteShadow" BlurRadius="5" Color="#000000" Opacity="0.12" ShadowDepth="1" Direction="270"/>
                </Image.Effect>
            </Image>


            <!-- ACCESSORIES LAYER (Overlaid accurately on real bird head, eye, crown, and neck) -->
            <Canvas x:Name="AccessoriesCanvas" ClipToBounds="False">
                <!-- 1. Reading Glasses 👓 (Directly on eye at X=232, Y=110) -->
                <Canvas x:Name="AccessoryGlasses" Visibility="Collapsed" Canvas.Left="218" Canvas.Top="102">
                    <Line X1="-4" Y1="7" X2="4" Y2="5" Stroke="#1E293B" StrokeThickness="2.0"/>
                    <Ellipse Canvas.Left="4" Canvas.Top="0" Width="18" Height="18" Stroke="#1E293B" StrokeThickness="2.0" Fill="#15FFFFFF"/>
                    <Path Data="M 21,7 C 24,5 28,5 31,8" Stroke="#1E293B" StrokeThickness="2.0"/>
                </Canvas>

                <!-- 2. Cool Sunglasses 🕶️ (Directly on eye at X=232, Y=110) -->
                <Canvas x:Name="AccessorySunglasses" Visibility="Collapsed" Canvas.Left="214" Canvas.Top="104">
                    <!-- Frame arm going back -->
                    <Line X1="0" Y1="4" X2="8" Y2="2" Stroke="#0F172A" StrokeThickness="2.0"/>
                    <!-- Dark curved lens -->
                    <Path Data="M 8,0 L 26,0 L 22,14 L 6,13 Z" Fill="#0F172A">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.45"/>
                        </Path.Effect>
                    </Path>
                    <!-- Glossy white reflection streak -->
                    <Line X1="10" Y1="3" X2="18" Y2="11" Stroke="#FFFFFF" StrokeThickness="1.5" Opacity="0.8"/>
                </Canvas>

                <!-- 3. Winter Scarf 🧣 (Wrapped on neck at X=196, Y=132) -->
                <Canvas x:Name="AccessoryScarf" Visibility="Collapsed" Canvas.Left="192" Canvas.Top="132">
                    <Path Data="M 0,0 C 14,5 34,5 42,-2 C 44,4 38,13 22,15 C 8,15 0,5 0,0 Z" Fill="#DC2626"/>
                    <Path Data="M 6,8 L 2,24 L 10,25 L 14,10 Z" Fill="#EF4444"/>
                </Canvas>

                <!-- 4. Aristocratic Top Hat 🎩 (Directly on crown at X=228, Y=98) -->
                <Canvas x:Name="AccessoryTopHat" Visibility="Collapsed" Canvas.Left="212" Canvas.Top="75">
                    <Ellipse Canvas.Left="0" Canvas.Top="19" Width="36" Height="8" Fill="#0F172A"/>
                    <Rectangle Canvas.Left="6" Canvas.Top="1" Width="24" Height="20" Fill="#1E293B" RadiusX="2" RadiusY="2"/>
                    <Rectangle Canvas.Left="6" Canvas.Top="17" Width="24" Height="4" Fill="#E11D48"/>
                </Canvas>

                <!-- 5. Party Hat 🥳 (Directly on crown at X=228, Y=98) -->
                <Canvas x:Name="AccessoryPartyHat" Visibility="Collapsed" Canvas.Left="216" Canvas.Top="68">
                    <Polygon Points="0,30 24,30 12,0" Fill="#8B5CF6"/>
                    <Ellipse Canvas.Left="9" Canvas.Top="-4" Width="7" Height="7" Fill="#FBBF24"/>
                </Canvas>

                <!-- 6. Nightcap 🌙 (Snug on head at X=228, Y=98) -->
                <Canvas x:Name="AccessoryNightcap" Visibility="Collapsed" Canvas.Left="210" Canvas.Top="70">
                    <Path Data="M 10,28 C 14,14 26,6 38,4 C 44,10 46,20 44,28 Z" Fill="#1D4ED8"/>
                    <Path Data="M 10,24 C 0,22 -6,34 -10,44" Stroke="#1D4ED8" StrokeThickness="7" StrokeEndLineCap="Round"/>
                    <Ellipse Canvas.Left="-14" Canvas.Top="42" Width="9" Height="9" Fill="#FACC15"/>
                </Canvas>

                <!-- 7. Rain Umbrella ☂️ (Hovering over the bird) -->
                <Canvas x:Name="AccessoryUmbrella" Visibility="Collapsed" Canvas.Left="130" Canvas.Top="35">
                    <Path Data="M 0,8 C 0,-24 84,-24 84,8 Z" Fill="#0284C7"/>
                    <Line X1="42" Y1="8" X2="42" Y2="85" Stroke="#475569" StrokeThickness="3.0"/>
                    <Path Data="M 42,85 C 42,94 32,94 32,87" Stroke="#475569" StrokeThickness="3.0" Fill="Transparent"/>
                </Canvas>
            </Canvas>
        </Grid>

        <!-- Golden Victorian Birdcage Layer ("খাঁচাবন্দি মোড") -->
        <Canvas x:Name="BirdCageCanvas" Width="260" Height="230" Visibility="Collapsed" ClipToBounds="False" IsHitTestVisible="False">
            <Canvas.Effect>
                <DropShadowEffect BlurRadius="10" Color="#EAB308" Opacity="0.30" ShadowDepth="1"/>
            </Canvas.Effect>
            <!-- Hanging Ring -->
            <Ellipse Canvas.Left="123" Canvas.Top="6" Width="14" Height="14" Stroke="#CA8A04" StrokeThickness="2.5" Fill="Transparent"/>
            <Ellipse Canvas.Left="126" Canvas.Top="18" Width="8" Height="8" Fill="#EAB308"/>
            <!-- Dome Arch -->
            <Path Data="M 28,60 C 28,26 80,26 130,26 C 180,26 232,26 232,60" Stroke="#EAB308" StrokeThickness="3.0" Fill="Transparent"/>
