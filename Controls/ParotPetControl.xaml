            <Line X1="28" Y1="60" X2="28" Y2="216" Stroke="#CA8A04" StrokeThickness="3.0"/>
            <Line X1="232" Y1="60" X2="232" Y2="216" Stroke="#CA8A04" StrokeThickness="3.0"/>
            <!-- Vertical Golden Cage Bars -->
            <Line X1="48" Y1="63" X2="48" Y2="216" Stroke="#EAB308" StrokeThickness="1.8" Opacity="0.80"/>
            <Line X1="72" Y1="63" X2="72" Y2="216" Stroke="#EAB308" StrokeThickness="1.8" Opacity="0.80"/>
            <Line X1="96" Y1="63" X2="96" Y2="216" Stroke="#EAB308" StrokeThickness="1.8" Opacity="0.80"/>
            <Line X1="120" Y1="63" X2="120" Y2="216" Stroke="#EAB308" StrokeThickness="1.8" Opacity="0.80"/>
            <Line X1="140" Y1="63" X2="140" Y2="216" Stroke="#EAB308" StrokeThickness="1.8" Opacity="0.80"/>
            <Line X1="164" Y1="63" X2="164" Y2="216" Stroke="#EAB308" StrokeThickness="1.8" Opacity="0.80"/>
            <Line X1="188" Y1="63" X2="188" Y2="216" Stroke="#EAB308" StrokeThickness="1.8" Opacity="0.80"/>
            <Line X1="212" Y1="63" X2="212" Y2="216" Stroke="#EAB308" StrokeThickness="1.8" Opacity="0.80"/>
